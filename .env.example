PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=true
JWT_SECRET=replace-with-a-long-random-secret
# ONE shared Zoho SMTP transport used by every app
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=indogroup@zohomail.in
SMTP_PASS=your-zoho-app-password
# Global sender identity; app templates/branding never change this.
SMTP_FROM=indogroup@zohomail.in
SMTP_TIMEOUT_MS=15000
CORS_ORIGIN=https://indomark.github.io
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
