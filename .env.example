PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=true
JWT_SECRET=replace-with-a-long-random-secret
# Shared Zoho Mail API transport used by every app
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API_URL=https://mail.zoho.in
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ACCOUNT_ID=your-zoho-account-id
# Global sender identity; app templates/branding never change this.
ZOHO_FROM=indogroup@zohomail.in
MAIL_API_TIMEOUT_MS=15000
CORS_ORIGIN=https://indomark.github.io
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
